// Evasive SuperTrend band logic derived from "Evasive SuperTrend [LuxAlgo]"
// (CC BY-NC-SA 4.0, https://creativecommons.org/licenses/by-nc-sa/4.0/) © LuxAlgo
// No-wick / compensation logic derived from "No Wick Candlestick Identifier".

//@version=6
strategy("Evasive SuperTrend + No-Wick Compensation", "EST + NoWick",
     overlay           = true,
     pyramiding        = 100,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     initial_capital   = 100000,
     max_labels_count  = 500,
     max_lines_count   = 500)
//@strategy_alert_message {{strategy.order.alert_message}}

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
color BULL_COLOR = #089981
color BEAR_COLOR = #f23645
color COMP_COLOR = color.rgb(255, 174, 53, 5)

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{
string ST_GROUP       = 'SuperTrend Settings'
int lengthInput       = input.int(10, 'ATR Length', minval = 1, group = ST_GROUP)
float multiplierInput = input.float(3.0, 'Base Multiplier', minval = 0.1, step = 0.1, group = ST_GROUP)

string NOISE_GROUP    = 'Noise Avoidance Logic'
float thresholdInput  = input.float(1.0, 'Noise Threshold (xATR)', minval = 0.1, step = 0.1, group = NOISE_GROUP, tooltip = 'If price gets closer to the band than this value, the band is pushed away and the bar is flagged noisy.')
float alphaInput      = input.float(0.5, 'Expansion Alpha (xATR)', minval = 0, step = 0.1, group = NOISE_GROUP, tooltip = 'Distance (in ATRs) to push the band away when noise is detected.')

string WICK_GROUP     = 'No-Wick Detection'
int tickTolInput      = input.int(0, 'Wick Tolerance (ticks)', minval = 0, group = WICK_GROUP, tooltip = 'A bar counts as no-wick if the wick on the open side is this many ticks or fewer. 0 reproduces the original exact open == low / open == high test.')

string TRADE_GROUP    = 'Entries'
bool allowLongInput   = input.bool(true, 'Allow Longs', group = TRADE_GROUP)
bool allowShortInput  = input.bool(true, 'Allow Shorts', group = TRADE_GROUP)
bool useNoWickInput   = input.bool(true, 'Enable No-Wick Adds', group = TRADE_GROUP, tooltip = 'Off: one unit per SuperTrend leg, taken on the flip only. On: every matching no-wick bar scales into the open leg, uncapped. The hard ceiling is Properties > Pyramiding, declared at 100.')
string addLocInput    = input.string('Pullback (near band)', 'Add Location Filter', options = ['Any', 'Pullback (near band)', 'Extension (away from band)'], group = TRADE_GROUP, tooltip = 'isNoisy is true when close sits within the noise threshold of the band, which in a trend is a pullback to support. Pullback requires isNoisy, Extension requires not isNoisy, Any ignores it. Extension reproduces the original build.')
bool reentryInput     = input.bool(true, 'Re-enter After Stop-Out', group = TRADE_GROUP, tooltip = 'Lets a matching no-wick bar re-open a leg that was fully stopped out while the SuperTrend has not yet flipped. Off leaves the leg dead until the next flip.')

string RISK_GROUP     = 'Risk (per unit)'
string stopBasisInput = input.string('Wider of ATR and Band', 'Stop Basis', options = ['ATR', 'SuperTrend Band', 'Wider of ATR and Band'], group = RISK_GROUP, tooltip = 'A pure ATR stop of 2x sits inside a 3x band, so it fires before the trend is invalidated. Wider of ATR and Band never places the stop tighter than the band.')
float slAtrInput      = input.float(2.0, 'Stop Loss (xATR)', minval = 0.1, step = 0.1, group = RISK_GROUP)
float bandBufInput    = input.float(0.25, 'Band Stop Buffer (xATR)', minval = 0, step = 0.05, group = RISK_GROUP, tooltip = 'Pushes the band-based stop past the band so an intrabar touch does not pre-empt the close-based flip. Applies to the no-wick add units.')
float flipExtraBufInput = input.float(1.0, 'Flip Extra Backstop (xATR)', minval = 0, step = 0.1, group = RISK_GROUP, tooltip = 'Extra distance added beyond the stop above, for the flip/runner unit only. The flip is meant to exit on the SuperTrend actually reversing, not on ordinary noise, so it gets a wider catastrophic backstop instead of the tighter tactical stop the adds use.')
float tpAtrInput      = input.float(3.0, 'Take Profit (xATR)', minval = 0.1, step = 0.1, group = RISK_GROUP, tooltip = 'Applies to no-wick units. The flip unit ignores it while Flip Unit Runs is on.')
bool runnerInput      = input.bool(true, 'Flip Unit Runs (no fixed TP)', group = RISK_GROUP, tooltip = 'The flip entry carries the widest stop, so giving it the same target as the adds hands it the worst payoff of any unit. On: the flip unit holds until the SuperTrend flips or its stop is hit, and the adds harvest the swings around it. Off: it takes the fixed target like every other unit.')

string VISUAL_GROUP   = 'Visualization'
bool showLabelsInput  = input.bool(true, 'Show Flip Labels', group = VISUAL_GROUP)
bool showFillsInput   = input.bool(true, 'Show Gradient Fills', group = VISUAL_GROUP)
bool showWicksInput   = input.bool(true, 'Show No-Wick Triangles', group = VISUAL_GROUP)
bool trendOnlyInput   = input.bool(true, 'Trend-Matching No-Wicks Only', group = VISUAL_GROUP, tooltip = 'Hides bullish no-wick bars while the SuperTrend is bearish and vice versa, for both the triangles and the compensation lines. Off shows every no-wick bar.')
bool showCompInput    = input.bool(true, 'Show Compensation Lines', group = VISUAL_GROUP)
int compBarsInput     = input.int(20, 'Compensation Line Length (bars)', minval = 1, group = VISUAL_GROUP, tooltip = 'Horizontal extent of the orange open-price line. The original script used timeframe.multiplier here, which gives 1 bar on 1m and 1D but 240 bars on 4H. This is visual only under the current exit mode.')
int compWidthInput    = input.int(1, 'Compensation Line Width (px)', minval = 1, maxval = 4, group = VISUAL_GROUP, tooltip = 'Pixel thickness only. Has no effect on any calculation or signal.')
bool showCompTxtInput = input.bool(false, 'Label Compensation Lines', group = VISUAL_GROUP)

//---------------------------------------------------------------------------------------------------------------------}
// Core Calculations
//---------------------------------------------------------------------------------------------------------------------{
float atr = ta.atr(lengthInput)

var float stBand = na
var int trend    = 1 // 1 for Bull, -1 for Bear

float src       = hl2
float upperBase = src + multiplierInput * atr
float lowerBase = src - multiplierInput * atr

float prevBand = nz(stBand[1], trend == 1 ? lowerBase : upperBase)

bool isNoisy = math.abs(close - prevBand) < (atr * thresholdInput)

if trend == 1
    if isNoisy
        stBand := prevBand - (atr * alphaInput)
    else
        stBand := math.max(lowerBase, prevBand)

    if close < stBand
        trend  := -1
        stBand := upperBase
else
    if isNoisy
        stBand := prevBand + (atr * alphaInput)
    else
        stBand := math.min(upperBase, prevBand)

    if close > stBand
        trend  := 1
        stBand := lowerBase

bool trendChanged = trend != trend[1]

// No-wick detection. The open-side wick is the one that must be absent.
float tol = tickTolInput * syminfo.mintick
bool bullNoWick = close > open and (open - low) <= tol
bool bearNoWick = close < open and (high - open) <= tol

// Drawing gate only. The trade conditions below re-test trend on their own.
bool drawBullWick = bullNoWick and (not trendOnlyInput or trend ==  1)
bool drawBearWick = bearNoWick and (not trendOnlyInput or trend == -1)

//---------------------------------------------------------------------------------------------------------------------}
// Signals
//---------------------------------------------------------------------------------------------------------------------{
bool tradeable = not na(atr) and bar_index > lengthInput

var int legId     = 0
var int addsUsed  = 0
var bool legOpened = false

if trendChanged
    legId     += 1
    addsUsed  := 0
    legOpened := false

float slDist = atr * slAtrInput
float tpDist = atr * tpAtrInput

// A 2xATR stop sits inside a 3xATR band, so on an adverse move it always fires before
// the flip. Taking the wider of the two keeps the stop outside trend invalidation.
float atrStopLong   = close - slDist
float atrStopShort  = close + slDist
float bandStopLong  = stBand - atr * bandBufInput
float bandStopShort = stBand + atr * bandBufInput

float rawStopLong  = stopBasisInput == 'ATR' ? atrStopLong : stopBasisInput == 'SuperTrend Band' ? bandStopLong : math.min(atrStopLong, bandStopLong)
float rawStopShort = stopBasisInput == 'ATR' ? atrStopShort : stopBasisInput == 'SuperTrend Band' ? bandStopShort : math.max(atrStopShort, bandStopShort)

// The band can sit on the wrong side of price right after an expansion push. A stop
// through the market fills instantly, so clamp it.
float stopLong  = math.min(rawStopLong, close - syminfo.mintick)
float stopShort = math.max(rawStopShort, close + syminfo.mintick)

// Flip unit gets a wider, catastrophic-only stop: it should exit on the SuperTrend
// reversing, not on the same noise the adds are sized to tolerate.
float flipStopLong  = math.min(rawStopLong - atr * flipExtraBufInput, close - syminfo.mintick)
float flipStopShort = math.max(rawStopShort + atr * flipExtraBufInput, close + syminfo.mintick)

// na limit means no target order, so the flip unit exits only on its stop or the flip.
float flipTpLong  = runnerInput ? na : close + tpDist
float flipTpShort = runnerInput ? na : close - tpDist

bool flipLong  = tradeable and trendChanged and trend ==  1 and allowLongInput
bool flipShort = tradeable and trendChanged and trend == -1 and allowShortInput

// isNoisy means close is within the noise threshold of the band, which in a trend is a
// pullback to support rather than chop. Extension reproduces the original filter.
bool locOk = addLocInput == 'Any' ? true : addLocInput == 'Pullback (near band)' ? isNoisy : not isNoisy

// Adds attach to an open leg, or re-open one the stops emptied while the trend held.
// legOpened keeps a no-wick bar from initiating a leg the flip never entered.
bool posLong  = strategy.position_size > 0
bool posShort = strategy.position_size < 0
bool flatLeg  = reentryInput and legOpened and strategy.position_size == 0

bool addLong  = useNoWickInput and tradeable and not trendChanged and trend ==  1 and allowLongInput and bullNoWick and locOk and (posLong or flatLeg)
bool addShort = useNoWickInput and tradeable and not trendChanged and trend == -1 and allowShortInput and bearNoWick and locOk and (posShort or flatLeg)

//---------------------------------------------------------------------------------------------------------------------}
// Orders
//---------------------------------------------------------------------------------------------------------------------{
// Brackets are anchored to the signal bar's close, not the fill price. With default
// fill-at-next-open the two differ by one bar's gap.
// Unit size is intentionally not an input: it comes from Properties > Order size.
if trendChanged and strategy.position_size != 0
    strategy.close_all(comment = "ST Flip", alert_message = "FLAT: SuperTrend flipped to " + (trend == 1 ? "BULL" : "BEAR"))

if flipLong
    legOpened := true
    string idL = "L" + str.tostring(legId) + ".0"
    strategy.entry(idL, strategy.long, comment = "Flip L", alert_message = "LONG @ market | SuperTrend flip bull")
    strategy.exit(idL + "x", from_entry = idL, stop = flipStopLong, limit = flipTpLong, comment_loss = "SL", comment_profit = "TP", alert_message = "CLOSE LONG unit " + idL)

if flipShort
    legOpened := true
    string idS = "S" + str.tostring(legId) + ".0"
    strategy.entry(idS, strategy.short, comment = "Flip S", alert_message = "SHORT @ market | SuperTrend flip bear")
    strategy.exit(idS + "x", from_entry = idS, stop = flipStopShort, limit = flipTpShort, comment_loss = "SL", comment_profit = "TP", alert_message = "CLOSE SHORT unit " + idS)

if addLong
    addsUsed += 1
    string idAL = "L" + str.tostring(legId) + "." + str.tostring(addsUsed)
    string kindL = posLong ? "Add L" : "Re-entry L"
    strategy.entry(idAL, strategy.long, comment = kindL + str.tostring(addsUsed), alert_message = "LONG @ market | no-wick unit " + str.tostring(addsUsed))
    strategy.exit(idAL + "x", from_entry = idAL, stop = stopLong, limit = close + tpDist, comment_loss = "SL", comment_profit = "TP", alert_message = "CLOSE LONG unit " + idAL)

if addShort
    addsUsed += 1
    string idAS = "S" + str.tostring(legId) + "." + str.tostring(addsUsed)
    string kindS = posShort ? "Add S" : "Re-entry S"
    strategy.entry(idAS, strategy.short, comment = kindS + str.tostring(addsUsed), alert_message = "SHORT @ market | no-wick unit " + str.tostring(addsUsed))
    strategy.exit(idAS + "x", from_entry = idAS, stop = stopShort, limit = close - tpDist, comment_loss = "SL", comment_profit = "TP", alert_message = "CLOSE SHORT unit " + idAS)

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
color stColor = trend == 1 ? BULL_COLOR : BEAR_COLOR

plot(trendChanged ? stBand : na, "Trend Switch Dot", color = stColor, style = plot.style_circles, linewidth = 4, join = false)

plotId = plot(stBand, "Band for Fill", color = na)
plot(isNoisy ? na : stBand, "Solid Band", color = stColor, linewidth = 2, style = plot.style_linebr)
plot(isNoisy ? stBand : na, "Dotted Band", color = stColor, linewidth = 2, style = plot.style_linebr, linestyle = plot.linestyle_dotted)

srcId = plot(src, "Source", color = na)

float topValue        = math.max(src, stBand)
float bottomValue     = math.min(src, stBand)
color topFillColor    = trend == 1 ? color.new(BULL_COLOR, 50) : color.new(BEAR_COLOR, 100)
color bottomFillColor = trend == 1 ? color.new(BULL_COLOR, 100) : color.new(BEAR_COLOR, 50)

fill(plotId, srcId, topValue, bottomValue, topFillColor, bottomFillColor,
     title   = "Trend Fill",
     display = showFillsInput ? display.all : display.none)

plotshape(showWicksInput and drawBullWick, "Bullish No Bottom Wick", location = location.belowbar, color = BULL_COLOR, style = shape.triangleup, size = size.tiny)
plotshape(showWicksInput and drawBearWick, "Bearish No Top Wick", location = location.abovebar, color = BEAR_COLOR, style = shape.triangledown, size = size.tiny)

if showCompInput and (drawBullWick or drawBearWick)
    line.new(bar_index, open, bar_index + compBarsInput, open, color = COMP_COLOR, width = compWidthInput, style = line.style_solid)
    if showCompTxtInput
        label.new(bar_index + compBarsInput + 1, open, "Compensation", style = label.style_label_left, color = COMP_COLOR, textcolor = #FFFFFF, size = size.tiny)

if showLabelsInput and trendChanged
    label.new(bar_index, stBand,
         text      = trend == 1 ? "BULL" : "BEAR",
         color     = stColor,
         textcolor = #FFFFFF,
         style     = trend == 1 ? label.style_label_up : label.style_label_down,
         size      = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
